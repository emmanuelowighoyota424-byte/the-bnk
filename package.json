{
  "name": "crestline-capital",
  "version": "1.0.0",
  "description": "Crestline Capital — secure digital banking platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "test": "node --test tests/*.test.mjs && tsx --test --test-force-exit tests/financial-postgres.test.ts",
    "test:financial": "tsx --test --test-force-exit tests/financial-postgres.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && node scripts/vercel-postinstall.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/speakeasy": "^2.0.10",
    "autoprefixer": "^10.4.19",
    "bcryptjs": "^2.4.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "jose": "^5.6.3",
    "next": "^14.2.5",
    "postcss": "^8.4.40",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "speakeasy": "^2.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.4",
    "zod": "^3.23.8",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.19.0",
    "tsx": "^4.16.5"
  }
}
