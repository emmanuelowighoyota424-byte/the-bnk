# Crestline Capital — Environment Variables

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
JWT_ACCESS_SECRET="replace-with-a-random-32-plus-character-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-32-plus-character-secret"
NEXT_PUBLIC_APP_URL="https://your-production-domain.example"
NODE_ENV="production"
BNK_ROUTING_NUMBER="000000000"

# Optional bootstrap administrator seed values; never use default credentials
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address
SMTP_PASSWORD=your-gmail-app-password
MAIL_FROM=Crestline Capital <your-gmail-address>

# Admin security
ADMIN_MASTER_KEY_HASH="<bcrypt-hash-of-48-character-hex-master-key>"

# Regulatory mode and regulated capabilities: fail closed by default.
REGULATORY_MODE="false"
FEATURE_DEPOSITS_ENABLED="false"
FEATURE_WITHDRAWALS_ENABLED="false"
FEATURE_LOANS_ENABLED="false"
FEATURE_GRANTS_ENABLED="false"
FEATURE_YIELD_ENABLED="false"
FEATURE_COPY_TRADING_ENABLED="false"
FEATURE_CRYPTO_ENABLED="false"
