# The Bnk — Environment Variables

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/thebnk?schema=public"

# JWT Secrets (generate strong random strings)
JWT_ACCESS_SECRET="change-me-access-secret-32-chars-min"
JWT_REFRESH_SECRET="change-me-refresh-secret-32-chars-min"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Admin Seed
ADMIN_EMAIL="admin@thebnk.com"
ADMIN_PASSWORD="Admin@123!"